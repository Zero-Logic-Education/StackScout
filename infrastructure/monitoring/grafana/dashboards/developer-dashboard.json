    {
      "datasource": "Prometheus",
      "description": "Top 10 slowest endpoints by p95 latency",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "custom": {
            "align": "auto",
            "cellOptions": {"type": "auto"},
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.5},
              {"color": "red", "value": 1}
            ]
          },
          "unit": "s"
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "p95 Latency"},
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {"type": "color-background"}
              }
            ]
          }
        ]
      },
      "gridPos": {"h": 10, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": ["sum"],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "p95 Latency"
          }
        ]
      },
      "targets": [
        {
          "expr": "topk(10, histogram_quantile(0.95, rate(http_server_requests_seconds_bucket{job=\"stackscout-backend\"}[5m])))",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Top 10 Slowest Endpoints (p95)",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "application": true,
              "job": true,
              "le": true
            },
            "indexByName": {},
            "renameByName": {
              "Value": "p95 Latency",
              "method": "Method",
              "uri": "Endpoint",
              "status": "Status"
            }
          }
        }
      ],
      "type": "table"
    },
