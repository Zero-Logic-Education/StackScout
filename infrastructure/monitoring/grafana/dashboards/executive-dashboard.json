        {
          "expr": "(1 - (sum(rate(http_server_requests_seconds_count{job=\"stackscout-backend\",status=~\"5..\"}[30d])) / sum(rate(http_server_requests_seconds_count{job=\"stackscout-backend\"}[30d])))) / 0.001 * 100",
